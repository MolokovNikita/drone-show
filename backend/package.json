{
  "name": "drone-backend",
  "version": "1.0.0",
  "description": "Backend API for drone light show management system",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
